# Sao chép thành .env rồi chỉnh; docker compose tự đọc file này.

POSTGRES_USER=smartcareer
POSTGRES_PASSWORD=smartcareer_pw
POSTGRES_DB=smartcareer
BI_READER_PASSWORD=bi_reader_pw

# Backend
JWT_SECRET=doi-chuoi-nay-it-nhat-32-ky-tu-ngau-nhien
DEFAULT_MODEL=m3
SEED_ON_START=1
SEED_PASSWORD=Demo@12345
# 1 = cài torch + sentence-transformers và tải model thật (image lớn); 0 = dùng embedder thay thế để chạy nhanh
WITH_ST=1

# Superset (dashboard BI)
SUPERSET_SECRET_KEY=doi-chuoi-nay-khac-it-nhat-32-ky-tu
GUEST_TOKEN_JWT_SECRET=doi-chuoi-guest-token-it-nhat-32-ky-tu
# Cổng Superset trên máy chủ (đổi nếu 8088 đã bị dùng)
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# Điền sau khi dựng dashboard: UUID nhúng (Embed dashboard) và id dataset v_funnel, v_funnel_stages (cách nhau dấu phẩy)
SUPERSET_DASHBOARD_ID=
SUPERSET_RLS_DATASET_IDS=

# Frontend (build): /api khi chạy qua nginx; đặt true để chạy bản demo không cần backend
VITE_API_URL=/api
VITE_OFFLINE_DEMO=false
